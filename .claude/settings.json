{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(node .claude/skills/verify/verify.mjs:*)",
      "Bash(node .claude/skills/design-system/audit.mjs:*)",
      "Bash(node .claude/skills/fix-design/screenshot.mjs:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)"
    ],
    "ask": [
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Bash(git push:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/typecheck.mjs", "timeout": 120 }]
      }
    ]
  }
}
